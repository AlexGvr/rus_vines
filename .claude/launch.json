{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wine-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "--port",
        "3300"
      ],
      "port": 3300
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "service.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8080"
      ],
      "port": 8080
    }
  ]
}
