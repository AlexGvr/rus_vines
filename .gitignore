# Полевой набор: сами фотографии чужие, в репозиторий не кладём.
# Пересобирается pipeline/collect_field.py по data/field/decisions.txt.
data/field/*.jpg
data/field/sheets/
data/field/candidates.json
# Проверка эталонов на устаревание: чужие фотографии витрин не храним,
# адреса и отчёт лежат в data/freshness.csv и data/index/freshness.json
data/freshness/
!data/catalog/extra_refs.csv
!data/catalog/equivalents.csv
# Кропы полевых кадров — производные тех же чужих фотографий
data/validation/*/crops
data/validation/*/lines/
# Резервные копии каталога и индексов перед пересборкой
data/index/*_prev*
data/catalog/*_prev*
# Кэши эмбеддингов экспериментов
data/validation/**/*.npz
